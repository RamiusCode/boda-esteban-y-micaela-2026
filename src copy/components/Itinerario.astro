---
// Itinerario.astro
const eventos = [
  { hora: "14:00", nombre: "Ceremonia Religiosa",                        icono: "/imagenes/iglesia.png" },
  { hora: "15:00", nombre: "Ceremonia Civil",                            icono: "/imagenes/anillo.png" },
  { hora: "16:00", nombre: "Sesión Fotográfica",                         icono: "/imagenes/foto.png" },
  { hora: "17:00", nombre: "Vals de los Novios y Brindis",               icono: "/imagenes/vals.png" },
  { hora: "17:30", nombre: "Cena",                                       icono: "/imagenes/cen.png" },
  { hora: "19:00", nombre: "Felicitaciones y compartir con los novios",  icono: "/imagenes/entrada.png" },
  { hora: "22:00", nombre: "Corte de la torta y lanzamiento del bouquet",icono: "/imagenes/tor.png" },
  { hora: "23:00", nombre: "Despedida",                                  icono: "/imagenes/despedida.png" },
];
---

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🕒 CRONOGRAMA / ITINERARIO - ESTILO TEXAS / VAQUERO         -->
<!-- ═══════════════════════════════════════════════════════════ -->
<section class="relative w-full overflow-hidden px-6 pt-2 pb-10" style="color:#5C4033;">

  <!-- 🌿 Flor lateral derecha (volteada), centrada verticalmente -->
  <img
    src="/imagenes/flor2.png"
    alt="" aria-hidden="true"
    class="pointer-events-none select-none absolute right-0 top-1/2 -translate-y-1/2 -mr-4 sm:-mr-5 w-20 sm:w-28 md:w-36 h-auto object-contain z-0 scale-x-[-1]"
    id="crono-flor-der"
  />

  <div class="max-w-md mx-auto px-4 relative z-10">

    <!-- Línea superior -->
    <div class="crono-regla mb-8" id="crono-regla-top" aria-hidden="true"></div>

    <!-- Título -->
    <h2 class="font-cormorant uppercase font-medium tracking-[0.28em] text-lg sm:text-xl text-center leading-relaxed mb-10 pl-[0.28em]" id="crono-titulo" style="color:#5C4033;">
      Itinerario de<br />nuestra boda
    </h2>

    <!-- Eventos -->
    <div class="flex flex-col gap-8 w-fit mx-auto" id="crono-lista">
      {eventos.map((ev) => (
        <div class="crono-item flex items-center gap-5 sm:gap-6">
          <!-- Ícono -->
          <div class="w-12 h-12 sm:w-14 sm:h-14 flex-shrink-0 flex items-center justify-center">
            <div class="crono-icono w-full h-full" style={`-webkit-mask-image:url('${ev.icono}'); mask-image:url('${ev.icono}');`}></div>
          </div>

          <!-- Divisor vertical -->
          <span class="crono-linea" aria-hidden="true"></span>

          <!-- Texto -->
          <div class="text-left">
            <p class="font-cormorant text-lg sm:text-xl font-semibold tracking-wide" style="color:#9C7B58;">{ev.hora}</p>
            <p class="font-cormorant uppercase font-normal tracking-normal text-sm sm:text-base leading-snug" style="color:#5C4033;">{ev.nombre}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Línea inferior -->
    <div class="crono-regla mt-8" id="crono-regla-bottom" aria-hidden="true"></div>

    <!-- Mensaje de agradecimiento -->
    <p class="font-cormorant text-xl sm:text-2xl leading-relaxed text-center mt-8 max-w-sm mx-auto" id="crono-gracias" style="color:#6B4A31;">
      ¡Gracias por acompañarnos en este día tan especial!
    </p>

  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  if (typeof window !== "undefined") {
    document.addEventListener("DOMContentLoaded", () => {
      gsap.set(["#crono-regla-top", "#crono-titulo", "#crono-regla-bottom", "#crono-gracias"], { opacity: 0, y: 20 });
      gsap.set(".crono-item", { opacity: 0, x: -40 });
      gsap.set("#crono-flor-der", { opacity: 0, x: 30 });

      ScrollTrigger.create({
        trigger: "#crono-titulo",
        start: "top 85%",
        onEnter: () => {
          gsap.to("#crono-flor-der", { opacity: 1, x: 0, duration: 1, ease: "power2.out" });
          const tl = gsap.timeline();
          tl.to(["#crono-regla-top", "#crono-titulo"], { opacity: 1, y: 0, duration: 0.7, ease: "power2.out", stagger: 0.1 })
            .to(".crono-item", { opacity: 1, x: 0, duration: 0.7, ease: "power2.out", stagger: 0.15 }, "-=0.3")
            .to(["#crono-regla-bottom", "#crono-gracias"], { opacity: 1, y: 0, duration: 0.6, ease: "power2.out", stagger: 0.12 }, "-=0.2");
        },
        onLeaveBack: () => {
          gsap.to(["#crono-regla-top", "#crono-titulo", ".crono-item", "#crono-regla-bottom", "#crono-gracias", "#crono-flor-der"], {
            opacity: 0, duration: 0.4, ease: "power2.in",
          });
        },
      });
    });
  }
</script>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎨 ESTILOS                                                  -->
<!-- ═══════════════════════════════════════════════════════════ -->
<style>
  /* Íconos tintados (beige) */
  .crono-icono {
    background-color: #9C7B58;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-size: contain;
    mask-size: contain;
  }

  /* Divisor vertical entre ícono y texto */
  .crono-linea {
    width: 1px;
    height: 2.75rem;
    background: #A9713F;
    opacity: 0.5;
    flex-shrink: 0;
  }

  /* Líneas horizontales (arriba y abajo) */
  .crono-regla {
    width: 100%;
    height: 1px;
    background: linear-gradient(to right, transparent, #A9713F, transparent);
    opacity: 0.5;
  }

  @media (max-width: 640px) {
    section { padding-left: 1.25rem; padding-right: 1.25rem; }
  }
</style>
