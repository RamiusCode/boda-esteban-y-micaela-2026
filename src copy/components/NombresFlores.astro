<!-- 🤠 PORTADA - ESTILO TEXAS / VAQUERO                         -->
<!-- Paleta marrón · texto #5C4033 · flor superior: flor1.png    -->
<!-- ═══════════════════════════════════════════════════════════ -->
<section class="relative w-full overflow-hidden flex items-center justify-center px-6 pt-12 pb-8" style="color:#5C4033;">

    <!-- 🌸 FLOR SUPERIOR DERECHA (flor1.png) -->
    <img
        src="/imagenes/flor1.png"
        alt="Flores decorativas"
        id="flor-sup-der"
        class="pointer-events-none select-none absolute top-0 right-0 w-32 sm:w-44 md:w-56 lg:w-64 h-auto object-contain z-0"
    />
    <!-- 🌿 FLOR INFERIOR IZQUIERDA (flor2.png) -->
    <img
        src="/imagenes/flor2.png"
        alt="Flores decorativas"
        id="flor-inf-izq"
        class="pointer-events-none select-none absolute left-0 top-1/2 -translate-y-1/2 w-16 sm:w-24 md:w-32 lg:w-36 h-auto object-contain z-0"
    />

    <!-- 🐴 ILUSTRACIÓN LATERAL DERECHA (costado.png) -->
    <img
        src="/imagenes/costado.png"
        alt=""
        aria-hidden="true"
        id="costado-der"
        class="pointer-events-none select-none absolute right-0 top-[58%] -translate-y-1/2 -mr-[5rem] sm:-mr-[6.25rem] md:-mr-[7.25rem] w-36 sm:w-48 md:w-56 h-auto object-contain z-0"
        style="opacity:1;"
    />

    <!-- 📝 CONTENIDO CENTRAL -->
    <div class="relative z-10 text-center max-w-2xl mx-auto flex flex-col items-center">

        <!-- 💠 LOGO EM (logo.png) -->
        <div class="mb-4" id="monograma">
            <img
                src="/imagenes/logo.png"
                alt="Logo Esteban y Micaela"
                class="w-16 sm:w-20 md:w-28 h-auto object-contain mx-auto"
            />
        </div>

        <!-- 🤠 SOMBRERO (sombrero.png) -->
        <div class="mt-4 sm:mt-5" id="sombrero-portada" aria-hidden="true">
            <img
                src="/imagenes/sombrero.png"
                alt=""
                class="w-[9.5rem] sm:w-[11.5rem] md:w-[13.5rem] h-auto object-contain mx-auto opacity-90"
            />
        </div>

        <!-- ✦ NOS CASAMOS -->
        <p class="font-cormorant font-normal text-base sm:text-lg md:text-xl tracking-[0.35em] uppercase mt-6 mb-6" id="nos-casamos" style="color:#A9713F;">
            Nos&nbsp;Casamos
        </p>

        <!-- 💑 NOMBRES -->
        <div class="w-full" id="nombres-container">
            <h1
                class="font-cormorant uppercase leading-none text-4xl sm:text-5xl md:text-6xl font-semibold tracking-[0.06em]"
                id="nombre-novio"
                style="color:#5C4033;"
            >Esteban</h1>

            <div class="font-great-vibes text-4xl sm:text-5xl md:text-6xl my-1 sm:my-2" id="ampersand" style="color:#A9713F;">
                y
            </div>

            <h1
                class="font-cormorant uppercase leading-none text-4xl sm:text-5xl md:text-6xl font-semibold tracking-[0.06em]"
                id="nombre-novia"
                style="color:#5C4033;"
            >Micaela</h1>
        </div>

        <!-- ✦ SEPARADOR (línea + rombo) -->
        <div class="flex items-center justify-center gap-3 w-full max-w-[220px] mx-auto mt-8" id="separador-fecha">
            <span class="sep-linea sep-linea-izq" aria-hidden="true"></span>
            <span class="sep-rombo" aria-hidden="true"></span>
            <span class="sep-linea sep-linea-der" aria-hidden="true"></span>
        </div>

        <!-- 📅 FECHA -->
        <div class="flex flex-col items-center mt-6 mb-6" id="fecha-portada">
            <p class="font-cormorant text-lg sm:text-xl tracking-normal uppercase mb-3" style="color:#A9713F;">Viernes</p>
            <div class="flex items-center justify-center gap-2 sm:gap-3">
                <span class="font-cormorant text-3xl sm:text-4xl font-medium tracking-normal text-center w-12 sm:w-14" style="color:#5C4033;">04</span>
                <span class="fecha-linea" aria-hidden="true"></span>
                <span class="font-cormorant text-lg sm:text-xl font-medium tracking-normal uppercase text-center" style="color:#5C4033;">Septiembre</span>
                <span class="fecha-linea" aria-hidden="true"></span>
                <span class="font-cormorant text-3xl sm:text-4xl font-medium tracking-normal text-center w-12 sm:w-14" style="color:#5C4033;">2026</span>
            </div>
        </div>

        <!-- 🕊️ SUBTÍTULO -->
        <p class="font-cormorant text-lg sm:text-xl md:text-2xl max-w-md leading-relaxed" id="subtitulo" style="color:#5C4033;">
            El amor es elegir cada día<br />a la misma persona y construir<br />juntos una historia.
        </p>

    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";

    document.addEventListener("DOMContentLoaded", () => {
        // ═══ FLORES DECORATIVAS ═══
        gsap.fromTo("#flor-sup-der", { opacity: 0, x: 60, y: -40 }, { opacity: 1, x: 0, y: 0, duration: 1, ease: "power2.out" });
        gsap.fromTo("#flor-inf-izq", { opacity: 0, x: -60, y: 40 }, { opacity: 1, x: 0, y: 0, duration: 1, ease: "power2.out", delay: 0.2 });

        // ═══ ILUSTRACIÓN LATERAL (caballo + cactus) ═══
        gsap.fromTo("#costado-der", { opacity: 0, x: 40 }, { opacity: 1, x: 0, duration: 1.1, ease: "power2.out", delay: 0.6 });

        // ═══ MONOGRAMA ═══
        gsap.fromTo("#monograma", { opacity: 0, scale: 0.6 }, { opacity: 1, scale: 1, duration: 0.8, ease: "back.out(1.4)", delay: 0.2 });

        // ═══ SOMBRERO ═══
        gsap.fromTo("#sombrero-portada", { opacity: 0, y: -12 }, { opacity: 0.9, y: 0, duration: 0.7, ease: "power2.out", delay: 0.35 });

        // ═══ NOS CASAMOS ═══
        gsap.fromTo("#nos-casamos", { opacity: 0, y: -15 }, { opacity: 1, y: 0, duration: 0.8, ease: "power2.out", delay: 0.4 });

        // ═══ FUNCIÓN: animar nombre letra por letra ═══
        function animarNombre(elementId, delay = 0) {
            const contenedor = document.getElementById(elementId);
            if (!contenedor) return;
            const texto = contenedor.textContent || "";
            contenedor.innerHTML = texto
                .split("")
                .map(
                    (letra) =>
                        `<span class="letra-cascada" style="opacity:0; display:inline-block; transform:translateY(20px) scale(0.85); filter:blur(2px);">${letra === " " ? "&nbsp;" : letra}</span>`
                )
                .join("");

            gsap.to(`#${elementId} .letra-cascada`, {
                opacity: 1,
                y: 0,
                scale: 1,
                filter: "blur(0px)",
                duration: 0.6,
                ease: "power2.out",
                stagger: { each: 0.05, from: "start" },
                delay: delay,
            });
        }

        animarNombre("nombre-novio", 0.5);
        gsap.fromTo("#ampersand", { opacity: 0, scale: 0.7 }, { opacity: 1, scale: 1, duration: 0.6, ease: "back.out(1.5)", delay: 0.8 });
        animarNombre("nombre-novia", 0.9);

        // ═══ SEPARADOR, FECHA Y SUBTÍTULO ═══
        gsap.fromTo("#separador-fecha", { opacity: 0, scaleX: 0.4 }, { opacity: 1, scaleX: 1, duration: 0.8, ease: "power2.out", delay: 1.1 });
        gsap.fromTo("#fecha-portada", { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.8, ease: "power2.out", delay: 1.2 });
        gsap.fromTo("#subtitulo", { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.8, ease: "power2.out", delay: 1.4 });
    });
</script>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎨 ESTILOS CSS                                              -->
<!-- ═══════════════════════════════════════════════════════════ -->
<style>
    /* ─ Separador línea + rombo (entre nombres y fecha) ─ */
    .sep-linea {
        flex: 1 1 0%;
        height: 1px;
        opacity: 0.65;
    }
    .sep-linea-izq {
        background: linear-gradient(to right, transparent, #A9713F);
    }
    .sep-linea-der {
        background: linear-gradient(to left, transparent, #A9713F);
    }
    .sep-rombo {
        width: 8px;
        height: 8px;
        background: #A9713F;
        transform: rotate(45deg);
        flex-shrink: 0;
    }

    /* ─ Líneas verticales delicadas de la fecha (se desvanecen en los extremos) ─ */
    .fecha-linea {
        display: inline-block;
        width: 1px;
        height: 2.25rem;
        background: linear-gradient(to bottom, transparent, #A9713F 50%, transparent);
        opacity: 0.75;
    }

    /* ✋ Efecto hover suave en letras de nombres */
    .letra-cascada {
        transition: all 0.3s ease;
        will-change: transform, opacity, filter;
    }
    .letra-cascada:hover {
        transform: translateY(-3px) scale(1.06) !important;
        text-shadow: 0 0 12px rgba(92, 64, 51, 0.35) !important;
    }

    /* 📱 Responsivo */
    @media (max-width: 640px) {
        section {
            padding-left: 1.25rem !important;
            padding-right: 1.25rem !important;
        }
    }
</style>
