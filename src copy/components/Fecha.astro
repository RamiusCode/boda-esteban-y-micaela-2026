    font-variant-numeric: lining-nums tabular-nums;
    font-feature-settings: "lnum" 1, "tnum" 1;
  }

  /* Números alineados (evita que el 4 / 0 bajen de la línea base) */
  .num-lining {
    font-variant-numeric: lining-nums tabular-nums;
    font-feature-settings: "lnum" 1, "tnum" 1;
  }
  @media (min-width: 768px) {
    .numero-dia { font-size: 4.5rem; }
  }

  /* Ornamento con estrella */
  .sep-linea {
    flex: 1 1 0%;
    height: 1px;
    opacity: 0.6;
  }
  .sep-linea-izq { background: linear-gradient(to right, transparent, #A9713F); }
  .sep-linea-der { background: linear-gradient(to left, transparent, #A9713F); }
  .sep-estrella {
    color: #A9713F;
    font-size: 0.9rem;
    line-height: 1;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    section { padding-left: 1rem; padding-right: 1rem; }
  }
</style>
