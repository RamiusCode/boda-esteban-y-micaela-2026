---
// Dedicatoria.astro
---
<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 📖 DEDICATORIA / VERSÍCULO - ESTILO TEXAS / VAQUERO         -->
<!-- ═══════════════════════════════════════════════════════════ -->
<section class="relative w-full overflow-hidden px-6 pt-6 pb-10" style="color:#5C4033;">

  <!-- 🌿 Hoja lateral izquierda -->
  <img
    src="/imagenes/hojalateral.png"
    alt="" aria-hidden="true"
    class="pointer-events-none select-none absolute left-0 top-1/2 -translate-y-1/2 -ml-3 sm:-ml-4 w-14 sm:w-16 h-auto object-contain opacity-60 z-0"
    id="ded-hoja-izq"
  />

  <div class="max-w-md mx-auto text-center flex flex-col items-center relative z-10">

    <!-- 🔝 Separador superior -->
    <div class="mb-6" id="ded-separador">
      <img
        src="/imagenes/separador2.png"
        alt=""
        aria-hidden="true"
        class="w-2/3 sm:w-3/5 h-auto object-contain mx-auto"
      />
    </div>

    <!-- ✦ Versículo -->
    <p class="font-cormorant text-xl sm:text-2xl leading-relaxed max-w-sm mx-auto" id="ded-texto" style="color:#5C4033;">
      <span class="comilla" aria-hidden="true">&laquo;</span>Por tanto, dejará el hombre a su padre y a su madre, y se unirá a su mujer, y serán una sola carne<span class="comilla" aria-hidden="true">&raquo;</span>
    </p>

    <!-- 📜 Referencia -->
    <p class="font-cormorant uppercase font-semibold tracking-[0.28em] text-base sm:text-lg pl-[0.28em] mt-5" id="ded-referencia" style="color:#A9713F;">
      Génesis 2:24
    </p>

    <!-- 🔻 Separador inferior (igual que el de arriba) -->
    <div class="mt-6" id="ded-sep">
      <img
        src="/imagenes/separador2.png"
        alt=""
        aria-hidden="true"
        class="w-2/3 sm:w-3/5 h-auto object-contain mx-auto"
      />
    </div>

  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  if (typeof window !== "undefined") {
    document.addEventListener("DOMContentLoaded", () => {
      const elementos = ["#ded-separador", "#ded-texto", "#ded-referencia", "#ded-sep"];

      gsap.set(elementos, { opacity: 0, y: 25 });
      gsap.set("#ded-hoja-izq", { opacity: 0, x: -25 });

      ScrollTrigger.create({
        trigger: "#ded-separador",
        start: "top 85%",
        onEnter: () => {
          gsap.to("#ded-hoja-izq", { opacity: 0.6, x: 0, duration: 1, ease: "power2.out" });
          gsap.to(elementos, { opacity: 1, y: 0, duration: 0.9, ease: "power2.out", stagger: 0.15 });
        },
        onLeaveBack: () => {
          gsap.to("#ded-hoja-izq", { opacity: 0, x: -25, duration: 0.4, ease: "power2.in" });
          gsap.to(elementos, { opacity: 0, y: 25, duration: 0.4, ease: "power2.in" });
        },
      });
    });
  }
</script>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎨 ESTILOS                                                  -->
<!-- ═══════════════════════════════════════════════════════════ -->
<style>
  /* Comillas angulares en tono acento */
  .comilla {
    color: #A9713F;
    font-size: 1.15em;
    line-height: 0;
  }

  @media (max-width: 640px) {
    section { padding-left: 1.25rem; padding-right: 1.25rem; }
  }
</style>
